# Demo 1: ERC-8004 Agent Registration with Filecoin Pin
# Copy this file to .env and fill in your values

# =============================================================================
# FILECOIN CALIBRATION TESTNET
# =============================================================================

# Your Ethereum private key (with 0x prefix)
# This wallet needs tFIL and USDFC on Filecoin Calibration testnet
PRIVATE_KEY=0x...

# Your wallet address (derived from private key above)
WALLET_ADDRESS=0x...

# Filecoin Calibration RPC (optional - uses default if not set)
FILECOIN_RPC=https://api.calibration.node.glif.io/rpc/v1

# USDFC token contract address on Filecoin Calibration testnet
# Filecoin format: t410fwmcconfwbcq3c3u6q2zxji7t4oe3jtpqxzn6yay
# Ethereum format: 0xb3042734b608a1B16e9e86B374A3f3e389B4cDf0 (used in scripts)
USDFC_TOKEN=0xb3042734b608a1B16e9e86B374A3f3e389B4cDf0

# =============================================================================
# BASE SEPOLIA TESTNET
# =============================================================================

# Base Sepolia RPC endpoint
BASE_SEPOLIA_RPC=https://sepolia.base.org

# ERC-8004 Identity Registry contract address on Base Sepolia
IDENTITY_REGISTRY=0x7177a6867296406881E20d6647232314736Dd09A

# =============================================================================
# DEMO VARIABLES (will be set during demo)
# =============================================================================

# IPFS CID of uploaded agent card (set after step 1)
# AGENT_CARD_CID=Qm...

# Token URI for agent registration (set after step 1)
# NOTE: Must include filename at the end!
# TOKEN_URI=ipfs://Qm.../github-agent-card.json

# Agent ID received after registration (set after step 2)
# Can be in hex (0x36) or decimal (54) format
# AGENT_ID=

# Dataset ID from Filecoin Pin upload (set after step 1)
# Get this from the upload output or by running: filecoin-pin data-set list
# DATASET_ID=

# =============================================================================
# GETTING TESTNET TOKENS
# =============================================================================

# Filecoin Calibration tFIL Faucet:
# https://faucet.calibnet.chainsafe-fil.io/funds.html

# USDFC Stablecoin (mint with tFIL as collateral):
# https://stg.usdfc.net

# Base Sepolia ETH Faucet (choose one):
# - Alchemy: https://www.alchemy.com/faucets/base-sepolia
# - QuickNode: https://faucet.quicknode.com/base/sepolia
# - Chainlink: https://faucets.chain.link/base-sepolia
